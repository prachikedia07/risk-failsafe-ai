generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id           String         @id @default(uuid())
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  customers    Customer[]
  riskAlerts   RiskAlert[]
  riskAnalyses RiskAnalysis[]
  transactions Transaction[]
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  merchantId   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String            @id @default(uuid())
  merchantId    String
  customerId    String
  amount        Int
  currency      String            @default("INR")
  status        TransactionStatus
  timestamp     DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  failureReason String?
  paymentMethod PaymentMethod
  razorpayPaymentId String? @unique
razorpayEventId   String? @unique
  customer      Customer          @relation(fields: [customerId], references: [id])
  merchant      Merchant          @relation(fields: [merchantId], references: [id])
}

model RiskAnalysis {
  id         String         @id @default(uuid())
  merchantId String
  riskScore  Int
  riskLevel  RiskLevel
  prediction RiskPrediction
  features   Json
  reasons    Json
  createdAt  DateTime       @default(now())
  riskAlerts RiskAlert[]
  merchant   Merchant       @relation(fields: [merchantId], references: [id])
}

model RiskAlert {
  id             String       @id @default(uuid())
  merchantId     String
  riskScore      Int
  riskLevel      RiskLevel
  title          String
  message        String
  status         AlertStatus  @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  riskAnalysisId String @unique
  action         AgentAction?
  confidence     Float?
  agentReasons Json?
  merchant       Merchant     @relation(fields: [merchantId], references: [id])
  riskAnalysis   RiskAnalysis @relation(fields: [riskAnalysisId], references: [id])
  investigationStatus String @default("PENDING")
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  OTHER
}

enum RiskPrediction {
  NORMAL
  SUSPICIOUS
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  REVIEWED
  RESOLVED
}

enum AgentAction {
  ALLOW
  REVIEW
  PAUSE
}
